{
	"phpsab.executablePathCS": "/Users/fastandcurious/.composer/vendor/bin/phpcs",
	"phpsab.executablePathCBF": "/Users/fastandcurious/.composer/vendor/bin/phpcbf",
	"phpsab.standard": "",
	"phpsab.autoRulesetSearch": true,
	"phpsab.snifferEnable": true,
